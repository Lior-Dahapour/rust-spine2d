[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
macos.debug = "bin/librust_spine2d.dylib"
macos.release = "bin/librust_spine2d.dylib"
linux.debug.x86_64 = "bin/librust_spine2d.so"
linux.release.x86_64 = "bin/librust_spine2d.so"
linux.debug.arm64 = "bin/librust_spine2d.so"
linux.release.arm64 = "bin/librust_spine2d.so"
windows.debug.x86_64 = "bin/rust_spine2d.dll"
windows.release.x86_64 = "bin/rust_spine2d.dll"
